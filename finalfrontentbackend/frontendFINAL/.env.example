# Copy to .env.local and fill in. Never put secrets in NEXT_PUBLIC_* variables:
# they are inlined into the browser bundle at build time.

# Base URL of your backend API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase → Project Settings → API (Data API / API Keys).
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The *publishable* key (sb_publishable_...) or the legacy "anon" key. Both are safe for browsers.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER add SUPABASE_SERVICE_ROLE_KEY (or an sb_secret_... key) to this frontend.
# It bypasses Row Level Security and belongs only in the backend's server-side env.
