# Copy to .env (git-ignored) and fill in. Never commit real values.

# development | test | production  (production disables /api/v1/docs)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Public publishable (sb_publishable_...) or legacy anon key. Same value as the frontend's
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Requests run with the caller's JWT, so RLS applies.
SUPABASE_ANON_KEY=

# BACKEND ONLY. Bypasses Row Level Security. Not used by any user-facing route.
# Never put this in the frontend and never name it NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Only for legacy projects still signing user JWTs with HS256 (JWT secret). Projects using
# JWT signing keys (ES256/RS256) are verified via the public JWKS and don't need this.
SUPABASE_JWT_SECRET=

# Allowed browser origin(s). Wildcards are rejected.
FRONTEND_URL=http://localhost:3000
# Optional extra origins, comma-separated: https://my-app.vercel.app,https://staging.example.com
CORS_ORIGINS=

# ---------------------------------------------------------------------------------------
# Optional integrations (backend only — never NEXT_PUBLIC_*). All may be left blank: the
# backend starts without them and a call to an unconfigured integration returns
# 503 INTEGRATION_NOT_CONFIGURED naming the variable to set. See app/integrations/README.md.
# ---------------------------------------------------------------------------------------

# AI providers. *_MODEL overrides the default model for that provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# xAI (OpenAI-compatible API). The xAI team needs credits, otherwise calls fail with 403.
GROK_API_KEY=
GROK_MODEL=grok-4-fast-non-reasoning

# GitHub token. A token with no scopes is enough for public data (raises limits to 5000/h).
GITHUB_TOKEN=
# HackNC sponsor tracks: Capital One Nessie (key from http://api.nessieisreal.com) and Photon Spectrum (app.photon.codes, promo HACKWITHPHOTON)
NESSIE_API_KEY=
# Legacy placeholder; Spectrum uses services/photon/.env (project ID + project secret).
PHOTON_API_KEY=

# Snowflake SQL REST API. Host only: org-account.snowflakecomputing.com (no https://).
# Create a scoped programmatic access token in Snowsight; OAuth is also supported.
SNOWFLAKE_ACCOUNT_HOST=
SNOWFLAKE_TOKEN=
SNOWFLAKE_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# Tiger Data is a separate PostgreSQL/Timescale service, not a Snowflake extension.
# Use the service connection URI. The adapter enforces sslmode=verify-full.
TIGERDATA_DSN=
# CA file path, or system when supported by the installed libpq.
TIGERDATA_SSL_ROOT_CERT=

# Geocoding: mapbox (access token) or google (Geocoding API key)
MAPS_PROVIDER=mapbox
MAPS_API_KEY=

# Email via Resend. EMAIL_FROM must be on a domain verified in Resend, e.g. "App <hi@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Incoming webhooks (the URL is the secret). Must start with https://hooks.slack.com/ or
# https://discord.com/api/webhooks/.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Per-user limit for /api/v1/integrations/* and /api/v1/ai/* generation calls (protects paid API
# credits). In-memory, per process.
INTEGRATIONS_RATE_LIMIT_PER_MINUTE=20

# AI layer (/api/v1/ai, see app/ai/README.md). Blank provider = first configured one.
AI_DEFAULT_PROVIDER=gemini
AI_MAX_PROMPT_CHARS=20000
AI_MAX_CONTEXT_CHARS=50000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_FILE_BYTES=5242880
AI_STREAM_TIMEOUT_SECONDS=120
