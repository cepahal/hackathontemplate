# =========================================================================================
# Hackathon Full-Stack Starter — environment variable reference. NO REAL VALUES HERE.
#
# This file documents every variable in one place. The apps do NOT read it directly:
#   - frontend  → copy the FRONTEND section to  frontendFINAL/.env.local   (or Vercel env vars)
#   - backend   → copy the BACKEND section to   backendFINAL/.env          (or Railway/Render env vars)
# Both targets are git-ignored. Details per variable: docs/ENVIRONMENT.md
# =========================================================================================


# =========================================================================================
# FRONTEND PUBLIC VARIABLES  (frontendFINAL — Vercel)
#
# Everything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle at BUILD time and
# is readable by anyone who opens the site. Only public values belong here. Never put a
# service-role key, sb_secret_ key, AI key, token or webhook URL in a NEXT_PUBLIC_ variable.
# =========================================================================================

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the deployed backend, no trailing slash (local: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000


# =========================================================================================
# BACKEND SECRET VARIABLES  (backendFINAL — Railway / Render / Docker)
#
# Server-side only. Set them in the hosting platform's environment settings, never in the
# frontend, never in the Dockerfile, never in git.
# =========================================================================================

# --- Required -----------------------------------------------------------------------------
ENVIRONMENT=production                  # development | test | production (production hides /api/v1/docs)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=                      # same public key as NEXT_PUBLIC_SUPABASE_ANON_KEY; RLS applies
FRONTEND_URL=https://your-app.vercel.app # exact browser origin allowed by CORS (no path, no wildcard)

# --- Optional core ------------------------------------------------------------------------
CORS_ORIGINS=                           # extra origins, comma-separated (e.g. a custom domain)
LOG_LEVEL=INFO
SUPABASE_SERVICE_ROLE_KEY=              # BYPASSES RLS. Backend only. Not used by any route today.
SUPABASE_JWT_SECRET=                    # only for legacy projects signing user JWTs with HS256

# --- AI providers (any subset; unconfigured providers return 503 INTEGRATION_NOT_CONFIGURED) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GROK_API_KEY=
GROK_MODEL=grok-4-fast-non-reasoning
AI_DEFAULT_PROVIDER=gemini              # Gemini is the hackathon default
AI_MAX_PROMPT_CHARS=20000
AI_MAX_CONTEXT_CHARS=50000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_FILE_BYTES=5242880
AI_STREAM_TIMEOUT_SECONDS=120

# --- External integrations (all optional) ---------------------------------------------------
GITHUB_TOKEN=
# HackNC sponsor tracks: Capital One Nessie (key from http://api.nessieisreal.com) and Photon Spectrum (app.photon.codes, promo HACKWITHPHOTON)
NESSIE_API_KEY=
PHOTON_API_KEY=                         # legacy placeholder; actual Spectrum values are in services/photon/.env
SNOWFLAKE_ACCOUNT_HOST=                # org-account.snowflakecomputing.com; no scheme/path
SNOWFLAKE_TOKEN=
SNOWFLAKE_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
SNOWFLAKE_CORTEX_MODEL=claude-sonnet-4-5 # Cortex REST uses the user's default role
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
TIGERDATA_DSN=                          # separate PostgreSQL/Timescale connection URI; verify-full SSL
TIGERDATA_SSL_ROOT_CERT=                # CA file path, or system on supported libpq
MAPS_PROVIDER=mapbox                    # mapbox | google
MAPS_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=                             # e.g. "App <hi@yourdomain.com>" on a domain verified in Resend
SLACK_WEBHOOK_URL=                      # the URL itself is the secret
DISCORD_WEBHOOK_URL=
INTEGRATIONS_RATE_LIMIT_PER_MINUTE=20   # per user, per process (in-memory)

# --- Container (set by the platform; defaults live in backendFINAL/Dockerfile) ----------------
# PORT=8000                             # Railway and Render inject this automatically
# WEB_CONCURRENCY=1                     # uvicorn workers; rate limits are per worker
