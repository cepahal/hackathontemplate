"use client";

// Copy to frontend/src/app/<feature-name>/page.tsx, then replace the labels.
// This page previews local input. No network request or persistence is included.
import { useState, type FormEvent } from "react";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";

export default function FeaturePage() {
  const [value, setValue] = useState("");
  const [preview, setPreview] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);

  function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const trimmedValue = value.trim();

    if (!trimmedValue) {
      setError("Enter a name before creating a preview.");
      setPreview(null);
      return;
    }

    setError(null);
    // Replace this local update with your agreed API call when ready.
    // Add pending state, response validation, and failure handling at that point.
    setPreview(trimmedValue);
  }

  return (
    <main className="mx-auto max-w-2xl px-6 py-12">
      <Card>
        <CardHeader>
          <CardTitle>New feature</CardTitle>
          <CardDescription>
            Start with a small workflow. This example previews your input locally.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <form id="feature-form" onSubmit={handleSubmit} noValidate>
            <div className="space-y-2">
              <label htmlFor="feature-name" className="text-sm font-medium">
                Name
              </label>
              <input
                id="feature-name"
                name="name"
                type="text"
                required
                maxLength={120}
                value={value}
                onChange={(event) => {
                  setValue(event.target.value);
                  setError(null);
                  setPreview(null);
                }}
                aria-invalid={Boolean(error)}
                aria-describedby={error ? "name-help name-error" : "name-help"}
                className="w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
              />
              <p id="name-help" className="text-sm text-muted-foreground">
                Up to 120 characters. Nothing is saved or sent to a server.
              </p>
              {error && (
                <p id="name-error" role="alert" className="text-sm text-destructive">
                  {error}
                </p>
              )}
            </div>
          </form>
          <div aria-live="polite" aria-atomic="true" className="mt-6 text-sm">
            {preview ? (
              <p className="break-words">Local preview: {preview}</p>
            ) : (
              <p className="text-muted-foreground">Your preview will appear here.</p>
            )}
          </div>
        </CardContent>
        <CardFooter className="flex gap-3">
          <Button type="submit" form="feature-form">
            Preview
          </Button>
          <Button
            type="button"
            variant="outline"
            onClick={() => {
              setValue("");
              setPreview(null);
              setError(null);
            }}
          >
            Reset
          </Button>
        </CardFooter>
      </Card>
    </main>
  );
}
