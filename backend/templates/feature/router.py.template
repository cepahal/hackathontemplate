"""Copy to app/modules/example/routes.py; then register in app/api/router.py."""

from fastapi import APIRouter

from app.modules.example.schemas import ExampleRequest, ExampleResponse
from app.modules.example.service import process_text

router = APIRouter(prefix="/examples", tags=["examples"])


@router.post("", response_model=ExampleResponse)
async def create_example(payload: ExampleRequest) -> ExampleResponse:
    return ExampleResponse(text=process_text(payload.text))
