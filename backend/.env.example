# Copy this file to backend/.env. The app resolves it regardless of your working directory.
APP_ENV=development
LOG_LEVEL=INFO
# A JSON array of exact browser origins. Wildcards and URL paths are rejected.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase (required for authenticated features; no service-role key in frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hosted HTTPS frontend; required by billing. Leave blank until deployed.
APP_PUBLIC_URL=

# AI: enable only providers you need, using model IDs available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
# Optional provider:model -> {input,output} USD per million. Empty means unknown cost.
AI_PRICES_PER_MILLION={}
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Stripe TEST mode; allowed prices are a JSON array, e.g. ["price_replace_me"].
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOWED_PRICE_IDS=[]
ALLOW_LIVE_PAYMENTS=false

# External integrations: shared account operations require the admin role.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Only needed if adapting the delegated OAuth template; use 32+ random characters.
OAUTH_STATE_SECRET=
