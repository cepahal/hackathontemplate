{
  "name": "hackathon-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Local Next.js and FastAPI foundation for hackathon projects",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node scripts/dev.mjs frontend",
    "dev:backend": "node scripts/dev.mjs backend",
    "check": "node scripts/check.mjs",
    "setup:mobile": "npm ci --prefix mobile",
    "dev:mobile": "npm --prefix mobile start",
    "check:mobile": "npm --prefix mobile run lint && npm --prefix mobile run typecheck && npm --prefix mobile run export:ios",
    "test:ui": "npm --prefix frontend run test:ui"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
