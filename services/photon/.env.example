# Terminal mode (npm start) needs no credentials.
# Cloud iMessage mode (npm start -- --imessage) requires your Photon project settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Optional text generation. Without a key the service returns an explicit transport-check reply.
# Reuse the dedicated backend key by copying its value here privately; the service does not read backend .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
