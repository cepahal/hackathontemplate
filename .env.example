# No application loads a root .env file. This file is a pointer, not configuration.
# npm run setup creates these application files without overwriting existing ones:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env.local
# Add server-only settings to backend/.env.example and browser-public settings to
# frontend/.env.example. Never put provider or service-role secrets in NEXT_PUBLIC_ variables.
